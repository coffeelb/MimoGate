msgid "Check"
msgstr "校验"

msgid "Clear log"
msgstr "清空日志"

msgid "Configuration is valid."
msgstr "配置有效。"

msgid "Edit the Mihomo YAML configuration directly. It is validated with \"mihomo -t\" before it is saved."
msgstr "直接编辑 Mihomo 的 YAML 配置。保存前会通过“mihomo -t”校验。"

msgid "No log entries yet."
msgstr "暂无日志。"

msgid "Not found"
msgstr "未找到"

msgid "Not saved: the configuration is invalid."
msgstr "配置无效，未保存。"

msgid "Running"
msgstr "运行中"

msgid "Save and restart"
msgstr "保存并重启"

msgid "Save"
msgstr "保存"

msgid "Saved, but the service failed to restart:"
msgstr "已保存，但服务重启失败："

msgid "Saved. Restart the service to apply the changes."
msgstr "已保存。重启服务后应用更改。"

msgid "Saved. The service was restarted."
msgstr "已保存，服务已重启。"

msgid "Stopped"
msgstr "未运行"

msgid "Unknown"
msgstr "状态未知"

msgid "Mihomo version"
msgstr "Mihomo 版本"

msgid "Unable to read the log."
msgstr "无法读取日志。"

msgid "Restore defaults"
msgstr "恢复默认"

msgid "Default configuration loaded. Save to apply it."
msgstr "已载入默认配置。请保存以应用。"

msgid "Service action failed."
msgstr "服务操作失败。"

msgid "Request failed."
msgstr "请求失败。"

msgid "The configuration exceeds the web editor size limit."
msgstr "配置超出网页传输上限。"

msgid "Intercepted ports"
msgstr "接管端口"

msgid "TCP and UDP destination ports outside this list bypass Mihomo. Separate ports with commas (,)."
msgstr "名单外的 TCP 和 UDP 目标端口绕过 Mihomo。请用英文逗号（,）分隔端口。"

msgid "Unable to apply port bypass."
msgstr "无法应用防火墙端口绕过。"

msgid "Unable to read the port list."
msgstr "无法读取接管端口。"

msgid "Mainland China IP"
msgstr "中国大陆 IP"

msgid "Cached"
msgstr "缓存"

msgid "Bundled snapshot"
msgstr "初始数据"

msgid "Update list"
msgstr "更新列表"

msgid "Updates are saved to cache and take effect the next time MimoGate starts."
msgstr "更新后将保存到缓存，下次重启 MimoGate 时生效。"

msgid "Mainland China IP list is already up to date."
msgstr "中国大陆 IP 列表已是最新。"

msgid "Mainland China IP list updated. Restart MimoGate to apply it."
msgstr "中国大陆 IP 列表已更新，重启 MimoGate 后生效。"

msgid "Unable to update mainland China IP list."
msgstr "无法更新中国大陆 IP 列表。"

msgid "This operation requires an OpenWrt root administrator session."
msgstr "此操作需要 OpenWrt root 管理员会话。"

msgid "Could not run Mihomo validation, or validation timed out."
msgstr "无法执行 Mihomo 校验，或校验超时。"

msgid "Mihomo configuration validation failed."
msgstr "Mihomo 配置校验失败。"

msgid "Could not read procd service status."
msgstr "无法读取 procd 服务状态。"

msgid "Could not read Mihomo version."
msgstr "无法读取 Mihomo 版本。"

msgid "Could not read boot status."
msgstr "无法读取开机自启状态。"

msgid "Could not read the configuration file."
msgstr "无法读取配置文件。"

msgid "The configuration file exceeds the 48 KiB web editor limit."
msgstr "配置文件超过网页编辑器的 48 KiB 上限。"

msgid "Another configuration check is already in progress. Please try again shortly."
msgstr "有一份配置正在校验，请稍后再试。"

msgid "Enter valid YAML text."
msgstr "请输入有效的 YAML 文本。"

msgid "Mihomo core was not found."
msgstr "未找到 Mihomo 内核。"

msgid "Could not create the configuration directory."
msgstr "无法创建配置目录。"

msgid "Could not create a temporary directory."
msgstr "无法创建临时目录。"

msgid "Could not write the temporary configuration file."
msgstr "无法写入临时配置文件。"

msgid "Could not save the configuration file."
msgstr "无法保存配置文件。"

msgid "Could not read the saved interception ports."
msgstr "无法读取已保存的接管端口。"

msgid "Interception port input is invalid or too long."
msgstr "接管端口输入无效或过长。"

msgid "Could not apply firewall port rules."
msgstr "无法应用防火墙端口规则。"

msgid "Could not update the mainland China IP list."
msgstr "无法更新中国大陆 IP 列表。"

msgid "Invalid service action."
msgstr "无效的服务操作。"

msgid "Save a YAML configuration on the Configuration page first."
msgstr "请先在配置文件页保存 YAML。"

msgid "Access control"
msgstr "访问控制"

msgid "All LAN devices"
msgstr "全部设备走代理"

msgid "Bypass listed devices"
msgstr "列表内设备直连"

msgid "Proxy listed devices only"
msgstr "仅列表内设备走代理"

msgid "-- Add online device (MAC / IP) --"
msgstr "-- 从在线设备添加（MAC / IP）--"

msgid "Control which LAN devices use Mihomo by MAC, IPv4, IPv6, or CIDR. Changes take effect the next time MimoGate starts."
msgstr "按 MAC、IPv4、IPv6 或 CIDR 控制局域网设备是否走 Mihomo（推荐优先选 MAC 可同时覆盖 IPv4/IPv6）。保存后下次启动 MimoGate 时生效。"

msgid "Unable to read access control settings."
msgstr "无法读取访问控制设置。"

msgid "Unable to save access control settings."
msgstr "无法保存访问控制设置。"

msgid "Could not read access control settings."
msgstr "无法读取访问控制设置。"

msgid "Invalid access control mode."
msgstr "无效的访问控制模式。"

msgid "Access control list is invalid or too long."
msgstr "访问控制列表无效或过长。"

msgid "Could not save access control settings."
msgstr "无法保存访问控制设置。"

msgid "Settings"
msgstr "设置"

msgid "Configuration management"
msgstr "配置管理"

msgid "MimoGate configuration management"
msgstr "MimoGate 配置管理"

msgid "Service status"
msgstr "服务状态"

msgid "General"
msgstr "常规设置"

msgid "Running status"
msgstr "运行状态"

msgid "Access control mode"
msgstr "访问控制模式"

msgid "Add online device"
msgstr "从在线设备添加"

msgid "Device list"
msgstr "设备列表"

msgid "Connection check"
msgstr "连通性测试"

msgid "Baidu"
msgstr "百度"

msgid "Google"
msgstr "Google"

msgid "unchecked"
msgstr "未测试"

msgid "passed"
msgstr "通过"

msgid "failed"
msgstr "失败"

msgid "MimoGate log"
msgstr "MimoGate 日志"

msgid "Mihomo log"
msgstr "Mihomo 日志"

msgid "Refresh every %d seconds."
msgstr "每 %d 秒刷新一次。"

msgid "Invalid test target."
msgstr "无效的测试目标。"

msgid "Proxy switch"
msgstr "代理开关"

msgid "Enable MimoGate and start on boot. Uncheck and click Save & Apply to stop the service."
msgstr "启用 MimoGate 并随开机自启。取消勾选后点击「保存并应用」将停止服务。"

msgid "Save & Apply"
msgstr "保存并应用"

msgid "Reset"
msgstr "复位"

msgid "Saved and applied."
msgstr "已保存并应用。"

msgid "Saved. Service stopped."
msgstr "已保存，服务已停止。"

msgid "Saved. Restart MimoGate to apply changes."
msgstr "已保存，重启 MimoGate 后生效。"

msgid "Panel"
msgstr "面板"

msgid "Enabled"
msgstr "已启用"

msgid "Disabled"
msgstr "已禁用"

msgid "Enable panel"
msgstr "启用面板"

msgid "Enables the Mihomo API and Zashboard web UI. The dashboard is downloaded on first use."
msgstr "启用 Mihomo API 与 Zashboard 网页控制台，首次使用时自动下载面板资源。"

msgid "Panel port"
msgstr "面板端口"

msgid "Panel secret"
msgstr "面板密钥"

msgid "Used to authenticate panel API access. It is recommended to set a custom secret instead of the default."
msgstr "用于验证面板 API 访问，建议修改为自定义密钥。"

msgid "Open Panel"
msgstr "打开面板"

msgid "Open Zashboard"
msgstr "打开 Zashboard 控制台"

msgid "Reject QUIC"
msgstr "拒绝 QUIC"

msgid "Rejects proxied QUIC (UDP 80/443) so applications fall back to TCP immediately. Direct traffic is unaffected."
msgstr "拒绝走代理的 QUIC（UDP 80/443）流量，使应用立即回退到 TCP；直连流量不受影响。"

msgid "IPv6 support"
msgstr "IPv6 支持"

msgid "Could not read settings."
msgstr "无法读取设置。"

msgid "Unable to save settings."
msgstr "无法保存设置。"

msgid "Could not save settings."
msgstr "无法保存设置。"

msgid "Panel port must be between 1 and 65535."
msgstr "面板端口必须在 1 到 65535 之间。"

msgid "Panel secret is invalid or too long."
msgstr "面板密钥无效或过长。"

msgid "Routing ports"
msgstr "路由端口"

msgid "Reveal/hide password"
msgstr "显示/隐藏密码"

msgid "Saved. Enable the proxy switch on the Settings page to start the service."
msgstr "已保存。代理开关当前未开启，请在设置页启用以启动服务。"

msgid "Enable IPv6 handling in Mihomo and the firewall. When disabled, IPv6 traffic bypasses Mihomo."
msgstr "启用 Mihomo 与防火墙的 IPv6 流量接管；关闭后 IPv6 流量直接绕过代理。"

msgid "Checking..."
msgstr "检测中..."
