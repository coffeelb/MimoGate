{
  "luci-app-mimogate": {
    "description": "Manage the MimoGate service and its YAML configuration",
    "read": {
      "ubus": {
        "mimogate": [ "status", "version", "boot_status", "read_config", "read_ports", "read_acl", "read_settings", "connection_check" ],
        "luci-rpc": [ "getHostHints" ]
      }
    },
    "write": {
      "ubus": {
        "mimogate": [ "service_action", "check_config", "save_config", "apply_ports", "save_acl", "save_settings", "update_cn" ]
      }
    }
  },
  "luci-app-mimogate-log": {
    "description": "Read the MimoGate log",
    "read": {
      "cgi-io": [ "download" ],
      "file": {
        "/var/log/mimogate/mimogate.log": [ "read" ],
        "/var/log/mimogate/mihomo.log": [ "read" ]
      }
    }
  }
}
